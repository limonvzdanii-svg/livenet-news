{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "livenet-news",
  "main": "worker.js",
  "compatibility_date": "2026-08-20",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "livenet-news",
      "database_id": "PASTE_YOUR_D1_DATABASE_ID_HERE"
    }
  ],

  "observability": {
    "enabled": true
  }
}
